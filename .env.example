# API (FastAPI) — copia a .env en local; en Railway usa Variables. Nunca subas .env.
APP_ENV=local
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Vacío = todos los módulos. Ej: distribucion,viaje
ENABLED_MODULES=
# Viaje: estado actual del feed + promedios históricos; LIVE=0 fuerza repetición.
LIVE=1
