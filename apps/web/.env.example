# Frontend (Vercel → Settings → Environment Variables). Solo valores públicos NEXT_PUBLIC_*.
NEXT_PUBLIC_DATA_MODE=api
# Para ensayar sin API: cambia a demo (ejemplos o snapshots según el módulo).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Opcional: URL pública para el QR (por defecto, el origen actual)
NEXT_PUBLIC_APP_URL=
# Opcional: estilo MapLibre (por defecto OpenFreeMap Positron, sin API key)
NEXT_PUBLIC_MAP_STYLE_URL=
